# VictoriaMetrics flags. Consumed by victoria-metrics.service as $VM_OPTS.
# systemd word-splits this on whitespace, so keep every flag on one line.
VM_OPTS=-httpListenAddr=127.0.0.1:8428 -retentionPeriod=30d -storageDataPath=/var/lib/victoria-metrics -promscrape.config=/etc/victoria-metrics/scrape.yaml -storage.minFreeDiskSpaceBytes=512MB
