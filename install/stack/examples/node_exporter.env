# node_exporter flags. Consumed by node_exporter.service as $NODE_EXPORTER_OPTS.
# The default collector set is disabled and re-enabled selectively: this cuts
# both series count (~350 total) and attack surface. thermal_zone is what
# reports Raspberry Pi SoC temperature.
NODE_EXPORTER_OPTS=--web.listen-address=127.0.0.1:9100 --collector.disable-defaults --collector.cpu --collector.meminfo --collector.loadavg --collector.filesystem --collector.diskstats --collector.netdev --collector.thermal_zone --collector.uname
