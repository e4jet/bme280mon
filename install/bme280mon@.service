[Unit]
# Template unit for running more than one sensor on a single Pi. It is installed
# but never enabled: a single-sensor host uses bme280mon.service and can ignore
# this file entirely.
#
#   sudo install -m 640 -o bme280mon -g bme280mon \
#       /etc/bme280mon/examples/second-sensor.yaml /etc/bme280mon/attic.yaml
#   sudo vi /etc/bme280mon/attic.yaml       # i2c_address, metrics_addr, location
#   sudo systemctl enable --now bme280mon@attic
#
# The instance name selects the config file, so do not use the name "config"
# (that file belongs to bme280mon.service).
Description=BME280 humidity monitor (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bme280mon
Group=i2c
ExecStart=/usr/local/bin/bme280mon -config /etc/bme280mon/%i.yaml
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/etc/bme280mon
DeviceAllow=/dev/i2c-1 rw

[Install]
WantedBy=multi-user.target
